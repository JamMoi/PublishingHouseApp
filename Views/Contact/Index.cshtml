@model PublishingHouseApp.Models.ContactFormModel
@{
    ViewData["Title"] = "Contact";
}

<h1>Contact Us</h1>

<div class="row mt-4">
    <!-- Osoite ja puhelin -->
    <div class="col-md-6 mb-4">
        <h2>Our Office</h2>
        <p>
            ExampleStreet 10<br />
            00100 Skopje<br />
            Macedonia
        </p>
        <p>
            <strong>Phone:</strong> +389 50 123 4567<br />
            <strong>Email:</strong> <a href="mailto:info@publishinghouse.com">info@publishinghouse.com</a>
        </p>

        <h4>Follow Us</h4>
        <a href="https://www.facebook.com/YourPage" target="_blank" class="btn btn-outline-primary btn-sm me-1">
            <i class="bi bi-facebook"></i> Facebook
        </a>
        <a href="https://www.instagram.com/YourPage" target="_blank" class="btn btn-outline-danger btn-sm me-1">
            <i class="bi bi-instagram"></i> Instagram
        </a>
        <a href="https://www.linkedin.com/company/YourPage" target="_blank" class="btn btn-outline-info btn-sm">
            <i class="bi bi-linkedin"></i> LinkedIn
        </a>

        <div class="mt-3">
            <a href="https://goo.gl/maps/YourMapLink" target="_blank" class="btn btn-primary">
                <i class="bi bi-geo-alt"></i> Get Directions
            </a>
        </div>
    </div>

    <!-- Google Maps -->
    <div class="col-md-6 mb-4">
        <h2>Find Us Here</h2>
        <div class="map-container" style="position:relative; padding-bottom:56.25%; height:0; overflow:hidden;">
            <iframe class="map-frame"
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2965.1490752659543!2d21.4107973!3d41.9970761!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1354144739377a8b%3A0x98123f629742fcc2!2sBagdadska%2016%2C%20Skopje%201000%2C%20Pohjois-Makedonia!5e0!3m2!1sfi!2sfi!4v1765187747121!5m2!1sfi!2sfi"
                    style="border:0; position:absolute; top:0; left:0; width:100%; height:100%;"
                    allowfullscreen
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade">
            </iframe>
        </div>
    </div>
</div>

<!-- FAQ Accordion -->
<h2 class="mt-5">Frequently Asked Questions</h2>
<div class="accordion mt-3" id="faqAccordion">
    <div class="accordion-item">
        <h2 class="accordion-header" id="faqHeading1">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                How can I order a book?
            </button>
        </h2>
        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
            <div class="accordion-body">
                You can order books directly from our website or visit our store.
            </div>
        </div>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header" id="faqHeading2">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                Can I contact authors directly?
            </button>
        </h2>
        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
            <div class="accordion-body">
                For author contact, please use the form below and we will forward your message.
            </div>
        </div>
    </div>
</div>

