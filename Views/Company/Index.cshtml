@{
    ViewData["Title"] = "About Us";
}

<h1 class="display-4">About Us</h1>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
<h2 class="h4 mb-3">Publishing House App</h2>

<p> We are dedicated to bringing you the best books from a variety of genres. Our team of experienced editors and passionate authors work together to create engaging and high-quality content for readers of all ages. FLIP BOOK BOOKS is a Skopje-based publishing house specializing in the production of graphic print materials.</p>

                <p>
                    Our company publishes a diverse selection of books and supports authors
                    throughout the publishing process, from manuscript development to reaching readers.
                </p>

                <h3 class="h5 mt-4">Our Team</h3>
                <p>
                    Our team consists of editors, publishing coordinators, customer service staff
                    and digital specialists. Together we make sure that books are presented clearly,
                    author information is maintained accurately and customers can easily explore our catalogue.
                </p>

                <h3 class="h5 mt-4">Our Mission</h3>
                <p class="mb-0">
                    Our mission is to make literature accessible, support writers and offer readers
                    a pleasant way to discover new books and authors.
                </p>
            </div>
        </div>
    </div>
</div>