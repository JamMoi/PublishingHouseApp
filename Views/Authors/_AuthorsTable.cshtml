@model IEnumerable<PublishingHouseApp.Models.Author>

    @if (User.IsInRole("Admin"))
{
    @* ADMIN taulukko*@
   
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Firstname</th>
            <th>Surname</th>
            <th>Email</th>
            <th>Phone Number</th>
            <th>Bio</th>
            <th>Date</th>
            <th>Books</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Firstname</td>
                    <td>@item.Surname</td>
                    <td>@item.Email</td>
                    <td>@item.PhoneNumber</td>
                    <td>@item.Bio</td>
                    <td>@item.Date.ToString("dd.MM.yyyy")</td>
                    <td>
                        @if (item.Books != null && item.Books.Any())
                        {
                            <ul class="mb-0">
                                @foreach (var book in item.Books)
                                {
                                    <li>@book.Title</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span>No books</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.AuthorId" class="btn btn-info btn-sm">Details</a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.AuthorId" class="btn btn-primary btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.AuthorId" class="btn btn-danger btn-sm">Delete</a>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center">No authors found</td>
            </tr>
        }
    </tbody>
</table>
}
else
{
       @*USER : KORTTINÄKYMÄ*@

            <div class="row">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <div class="col-md-4 col-lg-3 mb-4">
                            <div class="card h-100 shadow-sm">
                             <div class="card-body">
                                 <h5 class="card-title">
                                     @item.Firstname @item.Surname
                    </h5>

                       <p class="card-text">
                        <strong>Bio:</strong>
                        @(string.IsNullOrEmpty(item.Bio)
                        ? "No Bio available"
                        : item.Bio.Length > 200
                        ? item.Bio.Substring(0, 200) + "..."
                        : item.Bio)
                  </p>

                     <p class="card-text">
                         <strong>Books</strong>
                    @if (item.Books != null && item.Books.Any())
                         {
                             @string.Join(",", item.Books.Select(b => b.Title))
                         }
                         else
                         {
                             <span>No Books</span>
                         }
                       </p>

<a asp-action="Details"
   asp-route-id="@item.AuthorId"
   class="btn btn-secondary btn-sm">
    Details
</a>  
                    </div>
                   </div>
                 </div>
                    }
                }
                else
                {
                <div class="col-12 text-center">
                    <p>No authors found</p>
                </div>
                }
               
</div>
}
