@model IEnumerable<PublishingHouseApp.Models.Author>
@* Tämä kertoo Razorille, että näkymä saa malliksi Author-olioiden listan.
   IEnumerable<Author> = luettelo kirjailijoista.
   Tämä luettelo tulee suoraan controllerista, esim:
   return View(await db.Authors.ToListAsync());
*@

@{
    ViewData["Title"] = "Authors"; @* Html-sivun otsikko *@
}

<h1>Authors</h1> @* Sivun näkyvä otsikko *@

@* Hakukenttä kirjailijoiden live-hakua varten *@
<div class="mb-3">
    <input type="text" id="authorSearch" class="form-control" placeholder="Search authors..." />
</div>

@* 🔒 Vain admin näkee uuden kirjailijan lisäysnapin *@
@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" asp-controller="Authors" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Author
        </a>
    </p>
}

@* Tämä div sisältää kirjailijataulukon.
   Partial View _AuthorsTable renderöidään tänne aluksi koko mallin kanssa.
*@
<div id="authorsTableContainer">
    @await Html.PartialAsync("_AuthorsTable", Model)
</div>

<script>
    // Haetaan hakukenttä ja taulukon container JavaScriptiä varten
    const authorSearchInput = document.getElementById("authorSearch");
    const authorsTableContainer = document.getElementById("authorsTableContainer");

    let debounceTimer; // viivästää hakua, ettei pyyntö lähde jokaisesta näppäimestä heti

    // Kun käyttäjä kirjoittaa hakukenttään, tehdään AJAX-haku viiveellä
    authorSearchInput.addEventListener("keyup", function () {
        clearTimeout(debounceTimer);

        debounceTimer = setTimeout(async () => {
            const query = authorSearchInput.value;

            // Kutsuu AuthorsControllerin LiveSearch-metodia
            const response = await fetch(`/Authors/LiveSearch?query=${encodeURIComponent(query)}`);

            // Palautettu HTML sijoitetaan taulukon tilalle
            const html = await response.text();
            authorsTableContainer.innerHTML = html;
        }, 300);
    });
</script>