@model PublishingHouseApp.Models.PaginatedList<PublishingHouseApp.Models.Author> 
@{
    ViewData["Title"] = "Authors";
}

<h1>Authors</h1> @* Sivun näkyvä otsikko *@

@* Hakukenttä kirjailijoiden live-hakua varten *@
<form class="search-form mb-4"> 
    <div class="input-group">
                <input type="text"
                    id="authorSearch"
                    class="form-control"
                    placeholder="Search Authors..." />

                <button type="button" 
                    id="authorSearchButton"
                    class="btn btn-primary">
                    Search
                </button>
    </div>
</form>

@* 🔒 Vain admin näkee uuden kirjailijan lisäysnapin *@
@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" asp-controller="Authors" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Author
        </a>
    </p>
}

@* Tämä div sisältää kirjailijataulukon.
   Partial View _AuthorsTable renderöidään tänne aluksi koko mallin kanssa.
*@
<div id="authorsTableContainer">
    @await Html.PartialAsync("_AuthorsTable", Model)
</div>
@if (Model != null && Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center mt-4">

            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(Model.PageIndex - 1)">
                        Previous
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Previous</span>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                if (i == Model.PageIndex)
                {
                    <li class="page-item active">
                        <span class="page-link">@i</span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@i">
                            @i
                        </a>
                    </li>
                }
            }

            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(Model.PageIndex + 1)">
                        Next
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Next</span>
                </li>
            }

        </ul>
    </nav>
}


@section Scripts{
    <script src="~/js/author.js"></script>
}
