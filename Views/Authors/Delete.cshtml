@model PublishingHouseApp.Models.Author

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
@Html.ValidationSummary(false, "", new { @class = "text-danger" })
<div>
    <h4>Author</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Firstname) @*Näyttää arvot vain lukutilassa, ilman muokkausta*@
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Firstname)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Surname)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Surname)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PhoneNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PhoneNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Bio)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Bio)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Date)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Date)
        </dd>
    </dl>
    
    <form asp-action="Delete">@*→ Lähettää POST-kutsun DeleteConfirmed-metodille (nimetty ActionName-attribuutilla).Lähettää poistopyynnön AUthorControllerille*@
        <input type="hidden" asp-for="AuthorId" /> @*Ähettää ID:n näkymättä käyttäjälle. Piilotettu kenttä, joka sisältää AuthorId:n*@
        <input type="submit" value="Delete" class="btn btn-danger" /> |@*Poinike Delete , Suorittaa poistamisen*@
        <a asp-action="Index">Back to List</a> @*Linkki takaisin Author-listaukseen*@
    </form>
</div>
