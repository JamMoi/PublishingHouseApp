@model IEnumerable<PublishingHouseApp.Models.Author>

@{
    ViewData["Title"] = "Browse Authors";
}

<h1 class="mb-4">Browse Authors</h1>

@if (!Model.Any())
{
    <p>No authors available.</p>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card h-100 shadow-sm book-card">

                    <div class="card-body d-flex flex-column text-center">

                        <h5 class="card-title">
                            @item.Firstname @item.Surname
                        </h5>

                        <p class="card-text">
                            <strong>Books:</strong>

                            @if (item.Books != null && item.Books.Any())
                            {
                                @string.Join(", ", item.Books.Select(b => b.Title))
                            }
                            else
                            {
                                <span>No books</span>
                            }
                        </p>

                        <div class="mt-auto">
                            <a asp-action="Details"
                                   asp-route-id="@item.AuthorId"
                                   class="btn btn-secondary btn-sm w-100">
                                Details
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}