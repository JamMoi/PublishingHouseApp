@model IEnumerable<PublishingHouseApp.Models.Book>

@{
    ViewData["Title"] = "Home Page";
    var books = Model?.ToList() ?? new List<PublishingHouseApp.Models.Book>();
}

<div class="p-5 mb-5 bg-light rounded-4 shadow-sm text-center">
    <h1 class="display-4 fw-bold">Welcome to the Publishing House App!</h1>
    <p class="lead">
        Explore amazing stories, meet talented authors, and discover our newest published books.
    </p>

    <div class="mt-4">
        @*
    Tämä nappi vie käyttäjän BooksControllerin Browse-actioniin,
    joka näyttää kirjat visuaalisina kortteina
*@
        <a asp-controller="Books" asp-action="Browse" class="btn btn-primary btn-lg me-2">Browse Books</a>
        <a asp-controller="Authors" asp-action="Index" class="btn btn-outline-secondary btn-lg">Meet Authors</a>
    </div>
</div>

@if (books.Any())
{
    <div class="container">
        <div class="card shadow border-0 rounded-4 overflow-hidden">
            <div class="card-body p-4">

                <h2 class="text-center mb-4">Latest Available Books</h2>

                <div id="bookCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for (int i = 0; i < books.Count; i++)
                        {
                            var book = books[i];

                            var imageUrl = string.IsNullOrWhiteSpace(book.CoverImageUrl)
                                ? Url.Content("~/images/no-cover.png")
                                : Url.Content("~/images/" + book.CoverImageUrl);

                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <div class="row align-items-center g-4">

                                    <div class="col-md-6 text-center">
                                        <img src="@imageUrl"
                                             class="img-fluid rounded-4 shadow"
                                             alt="@book.Title"
                                             style="max-height: 420px; object-fit: contain;" />
        <!--debuggaus, yksi kansikuvista ei  näy--->
                                        <div class="mt-2 small text-muted">
                                            <p><strong>CoverImageUrl:</strong> @book.CoverImageUrl</p>
                                            <p><strong>Final imageUrl:</strong> @imageUrl</p>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="p-3">
                                            <h3 class="fw-bold">@book.Title</h3>

                                            <p class="text-muted mb-3">
                                                @(book.Author != null
                                                    ? book.Author.Firstname + " " + book.Author.Surname
                                                    : "Unknown author")
                                            </p>

                                            <p class="mb-2">
                                                <strong>Price:</strong> @book.Price €
                                            </p>

                                            <p class="mb-2">
                                                <strong>Published:</strong> @book.PublishedDate.ToString("dd.MM.yyyy")
                                            </p>

                                            <p class="mb-4">
                                                <strong>ISBN:</strong> @book.Isbn
                                            </p>

                                            <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId" class="btn btn-primary">
                                                View Details
                                            </a>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>

                    <button class="carousel-control-prev" type="button" data-bs-target="#bookCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>

                    <button class="carousel-control-next" type="button" data-bs-target="#bookCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>

                <div class="text-center mt-4">
                    @for (int i = 0; i < books.Count; i++)
                    {
                        <button type="button"
                                data-bs-target="#bookCarousel"
                                data-bs-slide-to="@i"
                                class="@(i == 0 ? "active" : "") btn btn-sm rounded-circle mx-1"
                                style="width:12px; height:12px; padding:0; border:none; background-color:#333;">
                        </button>
                    }
                </div>

            </div>
        </div>
    </div>
}
else
{
    <div class="text-center mt-5">
        <div class="alert alert-info shadow-sm">
            No books available at the moment.
        </div>
    </div>
}