@model IEnumerable<PublishingHouseApp.Models.Book>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to the Publishing House App!</h1>
    <p>Explore amazing stories, meet talented authors, and dive into our vibrant universe.</p>
</div>

@if (Model != null && Model.Any())
{
    <div id="bookCarouselWrapper" class="position-relative mt-5">

        <!-- Carousel -->
        <div id="bookCarousel" class="carousel slide" data-bs-ride="carousel">

            <div class="carousel-inner">
                @{
                    bool first = true;
                }

                @foreach (var book in Model)
                {
                    <div class="carousel-item @(first ? "active" : "") text-center">

                        @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                        {
                            <img src="@book.CoverImageUrl"
                                 class="d-block mx-auto"
                                 alt="@book.Title"
                                 style="height:400px; object-fit:contain;" />
                        }

                        <div class="mt-3">
                            <h5>@book.Title</h5>
                            <p>
                                <strong>Author:</strong> @(book.Author?.Firstname ?? "Unknown")<br />
                                <strong>Price:</strong> @book.Price €<br />
                                <strong>Published:</strong> @book.PublishedDate.ToString("dd.MM.yyyy")
                            </p>
                        </div>
                    </div>
                    first = false;
                }
            </div>

            <!-- Nuolet -->
            <button class="carousel-control-prev" type="button" data-bs-target="#bookCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#bookCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>

        </div>

        <!-- Pallot erikseen alareunaan -->
        <div class="text-center mt-2">
            @for (int i = 0; i < Model.Count(); i++)
            {
                <button type="button" data-bs-target="#bookCarousel" data-bs-slide-to="@i"
                        class="@(i == 0 ? "active" : "") btn btn-sm rounded-circle mx-1"
                        style="width:12px; height:12px; padding:0; border:none; background-color:#333;">
                </button>
            }
        </div>

    </div>
}
else
{
    <div class="text-center mt-5">
        <p>No books available at the moment.</p>
    </div>
}