@model PublishingHouseApp.ViewModels.BookEditViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Book</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Book.BookId" />

            <div class="form-group">
                <label asp-for="Book.AuthorId" class="control-label"></label>
                <select asp-for="Book.AuthorId" class="form-control" asp-items="ViewBag.AuthorId"></select>
                <span asp-validation-for="Book.AuthorId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.Isbn" class="control-label"></label>
                <input asp-for="Book.Isbn" class="form-control" />
                <span asp-validation-for="Book.Isbn" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.Title" class="control-label"></label>
                <input asp-for="Book.Title" class="form-control" />
                <span asp-validation-for="Book.Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.Editor" class="control-label"></label>
                <input asp-for="Book.Editor" class="form-control" />
                <span asp-validation-for="Book.Editor" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.PublishedDate" class="control-label"></label>
                <input asp-for="Book.PublishedDate" type="date" class="form-control" />
                <span asp-validation-for="Book.PublishedDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.Edition" class="control-label"></label>
                <input asp-for="Book.Edition" class="form-control" />
                <span asp-validation-for="Book.Edition" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Genres</label>

                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Select genres
                    </button>

                    <div class="dropdown-menu p-3" style="max-height: 300px; overflow-y: auto;">
                        @foreach (var genre in Model.AvailableGenres)
                        {
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="SelectedGenreIds"
                                       value="@genre.Id"
                                       id="genre_@genre.Id"
                                       checked="@(Model.SelectedGenreIds.Contains(genre.Id))" />

                                <label class="form-check-label" for="genre_@genre.Id">
                                    @genre.Name
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Book.Language" class="control-label"></label>
                <input asp-for="Book.Language" class="form-control" />
                <span asp-validation-for="Book.Language" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.Keywords" class="control-label"></label>
                <input asp-for="Book.Keywords" class="form-control" />
                <span asp-validation-for="Book.Keywords" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.PageCount" class="control-label"></label>
                <input asp-for="Book.PageCount" class="form-control" />
                <span asp-validation-for="Book.PageCount" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.Format" class="control-label"></label>
                <input asp-for="Book.Format" class="form-control" />
                <span asp-validation-for="Book.Format" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.FilePath" class="control-label"></label>
                <input asp-for="Book.FilePath" class="form-control" />
                <span asp-validation-for="Book.FilePath" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.CoverImageUrl" class="control-label"></label>
                <input asp-for="Book.CoverImageUrl" class="form-control" />
                <span asp-validation-for="Book.CoverImageUrl" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.Price" class="control-label"></label>
                <input asp-for="Book.Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Book.Price" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Book.IsAvailable" />
                    @Html.DisplayNameFor(model => model.Book.IsAvailable)
                </label>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}