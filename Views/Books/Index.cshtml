@model IEnumerable<PublishingHouseApp.Models.Book>//Näkymä odottaa listaa Book-olioista (IEnumerable<Book>).Tämä tarkoittaa, että controllerin Index-metodi lähettää näkymälle kaikkien kirjojen listan -->return View(await db.Books.Include(b => b.Author).ToListAsync());
@*Lista tulee controllerilta --> return View(await db.Books.Include(b => b.Author).ToListAsync());
*@


@{
    ViewData["Title"] = "Index";
}

<h1>PublishedBooks</h1>

    <p>
        <a asp-action="Create" asp-controller="Books" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Book
        </a>
    </p>
    <table class="table table-striped table-hover">
        @*Taulukon otsikot (thead)*@
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.First().Isbn)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.First().Title)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.First().Editor)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.First().PublishedDate)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.First().Edition)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.First().Genre)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.First().Language)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.First().Keywords)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.First().PageCount)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.First().Format)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.First().FilePath)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.First().CoverImageUrl)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.First().Price)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.First().IsAvailable)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.First().Author)
            </th>
            <th></th>
        </tr>
    </thead>
        <tbody>
            @*Datan renderöinti eli DisplayFor renderöi kunkin kirjan Title-kentän HTML:ksi ,Taulukon rungon täyttäminen, Model = kirjojen lista, item = yksi BOok kerrallaan (tbody)*@
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Isbn)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Editor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PublishedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Edition)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Genre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Language)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Keywords)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PageCount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Format)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FilePath)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CoverImageUrl)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsAvailable)
            </td>
            <td>
                    @(item.Author?.Firstname ?? "Unknown")
            </td>
            <td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-primary btn-sm">
                                <i class="bi bi-pencil-fill"></i> Edit
                            </a>
                            <a asp-action="Details" asp-route-id="@item.BookId" class="btn btn-info btn-sm">
                                <i class="bi bi-eye-fill"></i> Details
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.BookId" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash-fill"></i> Delete
                            </a>
                        </div>
                    </td>
            </td>
        </tr>
}
    </tbody>
</table>
