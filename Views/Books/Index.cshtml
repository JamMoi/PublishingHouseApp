@model IEnumerable<PublishingHouseApp.Models.Book>
@* Näkymä odottaa listaa Book-olioista (IEnumerable<Book>).
   Controllerin Index-metodi lähettää näkymälle kaikkien kirjojen listan.
   Esim. return View(await db.Books.Include(b => b.Author).ToListAsync());
*@

@{
    ViewData["Title"] = "Index";
}

<h1>PublishedBooks</h1>

@* Hakulomake kirjojen etsimiseen otsikon tai ISBN:n perusteella *@
<form asp-controller="Books" asp-action="Search" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="query" class="form-control" placeholder="Search books..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@* Vain admin näkee uuden kirjan lisäysnapin *@
@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" asp-controller="Books" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Book
        </a>
    </p>
}

<table class="table table-striped table-hover">
    @* Taulukon otsikot (thead)
       Käytetään tässä suoraan otsikkotekstejä, jotta sivu ei kaadu tyhjällä listalla.
    *@
    <thead>
        <tr>
            <th>ISBN</th>
            <th>Title</th>
            <th>Editor</th>
            <th>Published Date</th>
            <th>Edition</th>
            <th>Genre</th>
            <th>Language</th>

            @if (User.IsInRole("Admin"))
            {
                <th>Keyword</th>
            }
            ){}
            <th>Page Count</th>
            <th>Format</th>

            @if (User.IsInRole("Admin"))
            {
                <th>File Path</th>
                <th>Cover Image Url</th>
        
                 
            }
            <th>Price</th>
            <th>Available</th>
            <th>Author</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @* Jos listassa ei ole kirjoja, näytetään käyttäjälle viesti *@
        @if (!Model.Any())
        {
            <tr>
                <td colspan="16" class="text-center">
                    No books found.
                </td>
            </tr>
        }
        else
        {
            @* Taulukon rungon täyttäminen
               Model = kirjojen lista
               item = yksi Book kerrallaan
            *@
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Isbn)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Title)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Editor)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PublishedDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Edition)
                    </td>
                    <td>
                        @string.Join(", ", item.BookGenres.Select(bg => bg.Genre.Name))
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Language)
                    </td>
                    @if (User.IsInRole("Admin"))
                    {
                        <td>
                            @Html.DisplayFor(modelItem => item.Keywords)
                        </td>
                    }
                    <td>
                        @Html.DisplayFor(modelItem => item.PageCount)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Format)
                    </td>
                    @if (User.IsInRole("Admin"))
                    {
                        <td>
                            @Html.DisplayFor(modelItem => item.FilePath)
                            @Html.DisplayFor(modelItem => item.CoverImageUrl)

                        </td>
                    }
                   <td>
                        @Html.DisplayFor(modelItem => item.Price)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.IsAvailable)
                    </td>
                    <td>
                        @(item.Author !=null
                        ? item.Author.Firstname + " " + item.Author.Surname: "Unknown")
                    </td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            @* Details näkyy kaikille käyttäjille *@
                            <a asp-action="Details" asp-route-id="@item.BookId" class="btn btn-info btn-sm">
                                <i class="bi bi-eye-fill"></i> Details
                            </a>

                            @* Edit ja Delete näkyvät vain adminille *@
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-primary btn-sm">
                                    <i class="bi bi-pencil-fill"></i> Edit
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.BookId" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash-fill"></i> Delete
                                </a>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>