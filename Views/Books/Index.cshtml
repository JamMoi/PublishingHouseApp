@model PublishingHouseApp.Models.PaginatedList<PublishingHouseApp.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<h1>Published Books</h1>

<form class="search-form mb-4">
    <div class="input-group">
        <input type="text"
               id="booksSearch"
               class="form-control"
               placeholder="Search Books..." />

        <button type="button" 
            id="bookSearchButton"
            class="btn btn-primary">
            Search
        </button>
    </div>
</form>

<div id="booksContainer">
    @await Html.PartialAsync("_BooksList", Model)
</div>

@if (Model != null && Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center mt-4">

            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(Model.PageIndex - 1)">
                        Previous
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Previous</span>
                </li>
            }

            <li class="page-item active">
                <span class="page-link">
                    Page @Model.PageIndex of @Model.TotalPages
                </span>
            </li>

            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(Model.PageIndex + 1)">
                        Next
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Next</span>
                </li>
            }

        </ul>
    </nav>
}

@section Scripts {
    <script src="~/js/books.js" asp-append-version="true"></script>
}