@model PublishingHouseApp.Models.Book

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Book</h4>
    <hr />

    <dl class="row">

        @* ISBN *@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Isbn)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Isbn)
        </dd>

        @* Kirjan nimi *@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>

        @* Julkaisupäivä *@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PublishedDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PublishedDate)
        </dd>

        @* Kieli *@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Language)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Language)
        </dd>

        @* Sivumäärä *@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PageCount)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PageCount)
        </dd>

        @* Hinta *@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Price)
        </dd>

        @* Saatavuus *@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IsAvailable)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IsAvailable)
        </dd>

        <dt class="col-sm-2">
            Author
            <dt class="col-sm-2">
                
            </dt>
            <dd class="col-sm-10">
                @Model.Author.Firstname @Model.Author.Surname
            </dd>

        @* Vain admin näkee nämä *@
        @if (User.IsInRole("Admin"))
        {
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Editor)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Editor)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Edition)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Edition)
            </dd>

            <dt class="col-sm-2">
                Genres
            </dt>
            <dd class="col-sm-10">
                @string.Join(", ", Model.BookGenres.Select(bg => bg.Genre.Name))
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Keywords)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Keywords)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Format)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Format)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.FilePath)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.FilePath)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.CoverImageUrl)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.CoverImageUrl)
            </dd>
        }

    </dl>
</div>

<div class="mt-3">
    <a href="/Books"
       class="btn btn-secondary">
        Back to Books
    </a>
</div>