@model IEnumerable<PublishingHouseApp.Models.Book>

@{
    ViewData["Title"] = "Browse Books";
}

<h1 class="mb-4">Browse Books</h1>

@* 
    Tämä näkymä näyttää kirjat kortteina taulukon sijaan.
    Se on käyttäjäystävällisempi kuin hallintalistauksen tyyppinen Index-sivu.
*@

@if (!Model.Any())
{
    <p>No books available.</p>
}
else
{
    <div class="row">
        @* Käydään kaikki kirjat läpi yksi kerrallaan *@
        @foreach (var item in Model)
        {
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card h-100 shadow-sm book-card">
                    @*
                        Näytetään kansikuva, jos kirjalta löytyy CoverImageUrl.
                        Jos kuvaa ei ole, näytetään yksinkertainen placeholder-alue.
                    *@
                    @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                    {
                       @* <p>@item.CoverImageUrl</p>*@
                        var imagePath = item.CoverImageUrl.StartsWith("http")
                            ? item.CoverImageUrl
                            : Url.Content("~/images/" + item.CoverImageUrl);

                        <img src="@imagePath"
                             class="card-img-top bg-light"
                             alt="Book cover for @item.Title"
                             style="height: 360px; object-fit: contain; padding: 10px;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-light"
                             style="height: 320px;">
                            <span class="text-muted">No cover image</span>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        @* Kirjan nimi *@
                        <h5 class="card-title">@item.Title</h5>

                        @* Kirjailijan nimi *@
                        <p class="card-text mb-1">
                            <strong>Author:</strong>
                            @(item.Author != null
                                ? item.Author.Firstname + " " + item.Author.Surname
                                : "Unknown")
                        </p>

                        @* Genret pilkulla eroteltuna *@
                        <p class="card-text mb-1">
                            <strong>Genres:</strong>
                            @string.Join(", ", item.BookGenres.Select(bg => bg.Genre.Name))
                        </p>

                        @* Julkaisupäivä, jos haluat näyttää sen käyttäjälle *@
                        <p class="card-text mb-3">
                            <strong>Published:</strong>
                            @item.PublishedDate?.ToShortDateString()
                        </p>

                        @*
                            mt-auto työntää napin kortin alaosaan,
                            jolloin kaikki kortit näyttävät tasaisilta.
                        *@
                        <div class="mt-auto">
                            <a asp-action="Details"
                                   asp-route-id="@item.BookId"
                                   asp-route-returnAction="Browse"
                                   class="btn btn-primary w-100">
                                View Details
                            </a>
                            </div>
                    </div>
                </div>
            </div>
        }
    </div>
}